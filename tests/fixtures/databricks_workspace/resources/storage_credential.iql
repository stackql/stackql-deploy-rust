/*+ exists, postdelete_retries=1, postdelete_retry_delay=0 */
SELECT id AS storage_credential_id
FROM databricks_workspace.catalog.storage_credentials
WHERE deployment_name = '{{ deployment_name }}'
AND name = '{{ name }}'

/*+ create */
INSERT INTO databricks_workspace.catalog.storage_credentials (
  name,
  deployment_name
)
SELECT
  '{{ name }}',
  '{{ deployment_name }}'

/*+ statecheck, retries=1, retry_delay=0 */
SELECT COUNT(*) AS count
FROM databricks_workspace.catalog.storage_credentials
WHERE deployment_name = '{{ deployment_name }}'
AND name = '{{ name }}'

/*+ exports */
SELECT id AS storage_credential_id
FROM databricks_workspace.catalog.storage_credentials
WHERE deployment_name = '{{ deployment_name }}'
AND name = '{{ name }}'

/*+ delete */
DELETE FROM databricks_workspace.catalog.storage_credentials
WHERE name = '{{ name }}'
AND deployment_name = '{{ deployment_name }}'
